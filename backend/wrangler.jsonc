{
  "name": "drive-map",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-27",
  "assets": {
    "directory": "../frontend/dist"
  },
  "vars": {
    "LLM_MODEL": "nvidia/nemotron-3-nano-30b-a3b:free",
    "LLM_API_URL": "https://openrouter.ai/api/v1/chat/completions",
    "APP_ORIGIN": ""
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "drive-map-staging",
      "vars": {
        "LLM_MODEL": "nvidia/nemotron-3-nano-30b-a3b:free",
        "LLM_API_URL": "https://openrouter.ai/api/v1/chat/completions",
        "APP_ORIGIN": ""
      }
    },
    "production": {
      "name": "drive-map-production",
      "vars": {
        "LLM_MODEL": "nvidia/nemotron-3-nano-30b-a3b:free",
        "LLM_API_URL": "https://openrouter.ai/api/v1/chat/completions",
        "APP_ORIGIN": ""
      }
    }
  }
}
